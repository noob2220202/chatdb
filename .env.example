# 이 파일을 .env 로 복사해서 쓴다. 모든 값은 선택 사항이다.

# 텔레그램 API 키 (https://my.telegram.org → API development tools).
# 콘솔의 설정 화면에서 넣어도 된다. 화면에서 넣은 값이 우선한다.
# CHATDB_TG_API_ID=
# CHATDB_TG_API_HASH=

# 쿠키 서명과 세션 암호화에 쓰는 비밀 값. 비워 두면 데이터 폴더에 자동으로 만들어 재사용한다.
# 한번 정한 뒤에 바꾸면 저장된 텔레그램 세션을 다시 읽을 수 없다.
# CHATDB_SECRET_KEY=

# HTTPS 뒤에서 서비스할 때 true
# CHATDB_COOKIE_SECURE=false

# 텔레그램 없이 가짜 데이터로 화면을 둘러보는 데모 모드
# CHATDB_DEMO=false
